#! /usr/bin/bash

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
APP_DIR="$SCRIPT_DIR/App"
BUILD_DIR="$SCRIPT_DIR/build"
APP_BINARY="$BUILD_DIR/foosball_tracker"

function help() {
  cat <<EOF
Uzycie: $0 <opcja>

Dostepne opcje:
  configure  Instaluje niezbedne pakiety, np. cmake, opencv, gtest i clang-format.
  build      Buduje projekt przy uzyciu CMake.
  clean      Usuwa katalog build.
  format-check  Sprawdza formatowanie plikow C++ zgodnie z .clang-format.
  fix-format  Poprawia formatowanie plikow C++ zgodnie z .clang-format.
  test       Builduje i uruchamia testy projektu.
  app        Uruchamia aplikacje.
EOF
}

function find_clang_format() {
  local -a candidates=(clang-format-14 clang-format)

  for candidate in "${candidates[@]}"; do
    if command -v "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done

  echo "Brak clang-format. Zainstaluj clang-format-14 albo clang-format." >&2
  return 1
}

function require_install_privileges() {
  if [[ "$EUID" -eq 0 ]]; then
    return 0
  fi

  if ! command -v sudo >/dev/null 2>&1; then
    echo "Brak polecenia sudo. Uruchom skrypt jako root albo zainstaluj sudo."
    return 1
  fi

  if ! sudo -v; then
    echo "Uzytkownik nie ma uprawnien sudo. Uruchom skrypt jako root."
    return 1
  fi
}

function configure() {
  local -a privilege_prefix=()

  require_install_privileges || return 1

  if [[ "$EUID" -ne 0 ]]; then
    privilege_prefix=(sudo)
  fi

  if command -v apt >/dev/null 2>&1; then
    "${privilege_prefix[@]}" apt update
    "${privilege_prefix[@]}" apt install -y cmake libopencv-dev libgtest-dev clang-format-14
    return $?
  fi

  echo "Nieobslugiwany menedzer pakietow. Zainstaluj recznie: cmake, OpenCV, GoogleTest i clang-format."
  return 1
}

function build() {
  if ! command -v cmake >/dev/null 2>&1; then
    echo "Brak pakietu cmake. Zainstaluj cmake i sprobuj ponownie."
    return 1
  fi

  mkdir -p "$BUILD_DIR"
  cmake -S "$APP_DIR" -B "$BUILD_DIR"
  cmake --build "$BUILD_DIR"
}

function clean() {
  if [[ ! -d "$BUILD_DIR" ]]; then
    echo "Katalog build nie istnieje: $BUILD_DIR"
    return 0
  fi

  rm -rf "$BUILD_DIR"
}

function test() {
  build || return 1

  local tests_binary="$BUILD_DIR/Tests/unit_tests"
  if [[ ! -x "$tests_binary" ]]; then
    echo "Brak binarki testowej: $tests_binary"
    return 1
  fi

  "$tests_binary" --gtest_color=yes
}

function format_targets() {
  find "$APP_DIR" "$SCRIPT_DIR/Tests" \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' \) -print0
}

function fix_format() {
  local clang_format_bin

  clang_format_bin=$(find_clang_format) || return 1

  format_targets | xargs -0 "$clang_format_bin" -i --style=file
}

function format_check() {
  local clang_format_bin

  clang_format_bin=$(find_clang_format) || return 1

  if ! format_targets | xargs -0 "$clang_format_bin" --dry-run --Werror --style=file; then
    fix_format || return 1
    echo "Wykryto bledy formatowania. Uruchomiono ./run fix-format i poprawiono pliki." >&2
    return 1
  fi
}

function app() {
  if [[ ! -x "$APP_BINARY" ]]; then
    echo "Brak binarki: $APP_BINARY"
    echo "Uruchom ./run build, aby ją zbudować."
    return 1
  fi

  "$APP_BINARY"
}

case "$1" in
  build)
    build
    ;;
  clean)
    clean
    ;;
  test)
    test
    ;;
  format-check)
    format_check
    ;;
  fix-format)
    fix_format
    ;;
  app)
    app
    ;;
  configure)
    configure
    ;;
  *)
    help
    exit 1
    ;;
esac
