#! /usr/bin/bash

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
APP_DIR="$SCRIPT_DIR/App"
BUILD_DIR="$APP_DIR/build"
APP_BINARY="$BUILD_DIR/foosball_tracker"
TESTS_DIR="$SCRIPT_DIR/Tests"
TESTS_BUILD_DIR="$TESTS_DIR/build"
FRONTEND_BUILD_DIR="$APP_DIR/View/frontend/build"

function help() {
  cat <<EOF
Uzycie: $0 <opcja>

Dostepne opcje:
  configure        Instaluje komplet niezbednych pakietow (build, test, clang, format)
                    [--no-ui-tools] - nie instaluje Node.js/npm potrzebnych do zbudowania frontendu React
                    [--no-lfs] - nie konfiguruje ani nie pobiera plikow Git LFS
  build            Buduje projekt przy uzyciu CMake.
  clang-check      Uruchamia clang-tidy na plikach C++ projektu.
  include-check    Uruchamia include-what-you-use na plikach C++ projektu.
  clean            Usuwa katalogi build aplikacji, testow i frontendu oraz test_outputs.
  format-check     Sprawdza formatowanie C++ oraz header guardy z auto-poprawkami.
  format-check-ci  Sprawdza formatowanie C++, header guardy, clang-tidy oraz include-what-you-use bez auto-poprawek.
  format-fix       Poprawia formatowanie C++ oraz header guardy.
  test             Builduje i uruchamia testy projektu [--gtest_<*>, --log-level=<*> ].
  app              Uruchamia aplikacje [--log-level=<*>].
EOF
}

function require_install_privileges() {
  if [[ "$EUID" -eq 0 ]]; then
    return 0
  fi

  if ! command -v sudo >/dev/null 2>&1; then
    echo "Brak polecenia sudo. Uruchom skrypt jako root albo zainstaluj sudo."
    return 1
  fi

  if ! sudo -v; then
    echo "Uzytkownik nie ma uprawnien sudo. Uruchom skrypt jako root."
    return 1
  fi
}

function verify_min_iwyu_version() {
  local min_minor=$1
  local version_line=""
  local minor=""

  if ! command -v include-what-you-use >/dev/null 2>&1; then
    echo "Brak include-what-you-use po konfiguracji." >&2
    return 1
  fi

  version_line=$(include-what-you-use --version 2>/dev/null | head -n1)

  if [[ ! "$version_line" =~ include-what-you-use[[:space:]]+0\.([0-9]+) ]]; then
    echo "Nie mozna odczytac wersji include-what-you-use: $version_line" >&2
    return 1
  fi

  minor=${BASH_REMATCH[1]}
  if (( minor < min_minor )); then
    echo "Wersja include-what-you-use jest za stara: $version_line" >&2
    echo "Wymagane minimum: 0.${min_minor}" >&2
    return 1
  fi

  return 0
}

function ensure_nodejs_from_nodesource() {
  if command -v npm >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
    return 0
  fi

  if dpkg -l npm 2>/dev/null | grep -q '^ii'; then
    "${privilege_prefix[@]}" apt-get remove --purge -y npm || true
  fi

  if ! command -v curl >/dev/null 2>&1; then
    "${privilege_prefix[@]}" apt-get install -y curl || return 1
  fi

  if ! grep -q "deb.nodesource.com/node_20" /etc/apt/sources.list.d/nodesource.list 2>/dev/null; then
    curl -fsSL https://deb.nodesource.com/setup_20.x | "${privilege_prefix[@]}" bash - || return 1
  fi

  "${privilege_prefix[@]}" apt-get install -y nodejs || return 1

  if ! command -v npm >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1; then
    echo "Nie udalo sie zainstalowac Node.js/npm z NodeSource." >&2
    return 1
  fi

  return 0
}

function configure() {
  configure_mode=""
  lfs_enabled=true
  privilege_prefix=()
  install_packages=()
  llvm_major=18
  codename=""

  for arg in "$@"; do
    if [[ "$arg" == "--no-ui-tools" ]]; then
      configure_mode="--no-ui-tools"
    elif [[ "$arg" == "--no-lfs" ]]; then
      lfs_enabled=false
    fi
  done

  if [[ "$configure_mode" == "--no-ui-tools" ]]; then
    additional_packages=()
  fi

  require_install_privileges || return 1

  if [[ "$EUID" -ne 0 ]]; then
    privilege_prefix=(sudo)
  fi

  if command -v apt >/dev/null 2>&1; then
    if ! command -v lsb_release >/dev/null 2>&1; then
      echo "Brak lsb_release. Zainstaluj lsb-release." >&2
      return 1
    fi

    codename=$(lsb_release -cs)

    "${privilege_prefix[@]}" apt update
    "${privilege_prefix[@]}" apt install -y wget gpg lsb-release ca-certificates
    "${privilege_prefix[@]}" mkdir -p /usr/share/keyrings
    wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | "${privilege_prefix[@]}" gpg --yes --dearmor -o /usr/share/keyrings/llvm-archive-keyring.gpg
    printf 'deb [signed-by=/usr/share/keyrings/llvm-archive-keyring.gpg] http://apt.llvm.org/%s/ llvm-toolchain-%s-%s main\n' "$codename" "$codename" "$llvm_major" | "${privilege_prefix[@]}" tee /etc/apt/sources.list.d/llvm-toolchain-${llvm_major}.list >/dev/null

    "${privilege_prefix[@]}" apt install -y software-properties-common
    "${privilege_prefix[@]}" add-apt-repository ppa:ubuntu-toolchain-r/test -y

    "${privilege_prefix[@]}" apt update

    install_packages=(
      build-essential
      cmake
      git
      git-lfs
      libopencv-dev
      libgtest-dev
      libspdlog-dev
      libfmt-dev
      libleveldb-dev
      libsnappy-dev
      nlohmann-json3-dev
      clang-format-18
      clang-tidy-18
      iwyu
      g++-14
    )

    "${privilege_prefix[@]}" apt install -y "${install_packages[@]}"

    "${privilege_prefix[@]}" update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 150 --slave /usr/bin/g++ g++ /usr/bin/g++-14
    "${privilege_prefix[@]}" update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-18 100

    if ! verify_min_iwyu_version "$llvm_major"; then
      echo "Pakiet iwyu z apt jest za stary. Budowanie IWYU zrodlowo dla clang_${llvm_major}."
      "${privilege_prefix[@]}" apt install -y git ninja-build "clang-${llvm_major}" "llvm-${llvm_major}-dev" "libclang-${llvm_major}-dev"

      iwyu_src_dir=$(mktemp -d) || return 1

      if ! git clone --depth 1 --branch "clang_${llvm_major}" https://github.com/include-what-you-use/include-what-you-use.git "$iwyu_src_dir"; then
        rm -rf "$iwyu_src_dir"
        return 1
      fi

      if ! cmake -S "$iwyu_src_dir" -B "$iwyu_src_dir/build" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH="/usr/lib/llvm-${llvm_major}"; then
        rm -rf "$iwyu_src_dir"
        return 1
      fi

      if ! cmake --build "$iwyu_src_dir/build"; then
        rm -rf "$iwyu_src_dir"
        return 1
      fi

      if ! "${privilege_prefix[@]}" cmake --install "$iwyu_src_dir/build"; then
        rm -rf "$iwyu_src_dir"
        return 1
      fi

      rm -rf "$iwyu_src_dir"

      verify_min_iwyu_version "$llvm_major" || return 1
    fi

    if [[ "$lfs_enabled" == true ]]; then
      if ! git -C "$SCRIPT_DIR" lfs install --local; then
        echo "Nie udalo sie skonfigurowac Git LFS dla repozytorium." >&2
        return 1
      fi

      if ! git -C "$SCRIPT_DIR" lfs pull; then
        echo "Nie udalo sie pobrac plikow Git LFS dla repozytorium." >&2
        return 1
      fi
    fi

    if [[ "$configure_mode" != "--no-ui-tools" ]]; then
      ensure_nodejs_from_nodesource || return 1
      install_frontend_dependencies || return 1
    fi

    return $?
  fi

  echo "Nieobslugiwany menedzer pakietow. Zainstaluj recznie: build-essential, cmake, OpenCV, GoogleTest, spdlog, fmt, Node.js/npm, clang-format, clang-tidy, include-what-you-use."
  return 1
}

function install_frontend_dependencies() {
  local frontend_dir="$APP_DIR/View/frontend"
  local react_scripts_bin="$frontend_dir/node_modules/.bin/react-scripts"

  if ! command -v npm >/dev/null 2>&1; then
    echo "Brak pakietu npm. Zainstaluj Node.js/npm i sprobuj ponownie."
    return 1
  fi

  if [[ -x "$react_scripts_bin" ]]; then
    return 0
  fi

  if [[ -d "$frontend_dir/node_modules" ]]; then
    echo "Znaleziono niepelny katalog node_modules. Wznowienie instalacji zaleznosci frontendu."
    rm -rf "$frontend_dir/node_modules"
  fi

  echo "Instalowanie zaleznosci frontendu w $frontend_dir"
  (cd "$frontend_dir" && npm install --no-fund --no-audit --loglevel=error) || return 1

  if [[ ! -x "$react_scripts_bin" ]]; then
    echo "Nie udalo sie zainstalowac zaleznosci frontendu. Sprawdz npm i plik package.json." >&2
    return 1
  fi
}

function build_frontend() {
  local frontend_dir="$APP_DIR/View/frontend"

  install_frontend_dependencies || return 1

  if ! command -v npm >/dev/null 2>&1; then
    echo "Brak pakietu npm. Zainstaluj Node.js/npm i sprobuj ponownie."
    return 1
  fi

  (cd "$frontend_dir" && CI=true npm run build) || return 1
}

function build() {
  if ! command -v cmake >/dev/null 2>&1; then
    echo "Brak pakietu cmake. Zainstaluj cmake i sprobuj ponownie."
    return 1
  fi

  build_frontend || return 1

  mkdir -p "$BUILD_DIR"
  cmake -S "$APP_DIR" -B "$BUILD_DIR"
  cmake --build "$BUILD_DIR"
}

function clean() {
  if [[ ! -d "$BUILD_DIR" && ! -d "$TESTS_BUILD_DIR" && ! -d "$FRONTEND_BUILD_DIR" && ! -d "$TESTS_DIR/test_outputs" ]]; then
    echo "Katalogi build nie istnieja: $BUILD_DIR, $TESTS_BUILD_DIR, $FRONTEND_BUILD_DIR, $TESTS_DIR/test_outputs"
    return 0
  fi

  rm -rf "$BUILD_DIR" "$TESTS_BUILD_DIR" "$FRONTEND_BUILD_DIR" "$TESTS_DIR/test_outputs"
}

function build_tests() {
  if ! command -v cmake >/dev/null 2>&1; then
    echo "Brak pakietu cmake. Zainstaluj cmake i sprobuj ponownie."
    return 1
  fi

  mkdir -p "$TESTS_BUILD_DIR"
  cmake -S "$TESTS_DIR" -B "$TESTS_BUILD_DIR"
  cmake --build "$TESTS_BUILD_DIR"
}

function test() {
  build_tests || return 1

  tests_binary="$TESTS_BUILD_DIR/unit_tests"

  if [[ ! -x "$tests_binary" ]]; then
    echo "Brak binarki testowej: $tests_binary"
    return 1
  fi

  local log_level=""
  local args_for_gtest=()

  for arg in "$@"; do
    if [[ "$arg" == --log-level=* ]]; then
      log_level="${arg#--log-level=}"
    else
      args_for_gtest+=("$arg")
    fi
  done

  if [[ -n "$log_level" ]]; then
    export LOG_LEVEL="$log_level"
  fi

  "$tests_binary" --gtest_color=yes "${args_for_gtest[@]}"
}

function app() {
  if [[ ! -x "$APP_BINARY" ]]; then
    echo "Brak binarki: $APP_BINARY"
    echo "Uruchom ./run build, aby ją zbudować."
    return 1
  fi

  local log_level=""
  local args_for_app=()

  for arg in "$@"; do
    if [[ "$arg" == --log-level=* ]]; then
      log_level="${arg#--log-level=}"
    else
      args_for_app+=("$arg")
    fi
  done

  if [[ -n "$log_level" ]]; then
    export LOG_LEVEL="$log_level"
  fi

  echo "Foosball Tracker dostepny pod adresem http://localhost:8080"
  "$APP_BINARY" "${args_for_app[@]}"
}

case "$1" in
  build)
    build
    ;;
  clean)
    clean
    ;;
  test)
    shift
    test "$@"
    ;;
  clang-check)
    bash "$SCRIPT_DIR/run-checks" clang-check
    ;;
  include-check)
    bash "$SCRIPT_DIR/run-checks" include-check
    ;;
  format-check)
    bash "$SCRIPT_DIR/run-checks" format-check
    ;;
  format-check-ci)
    bash "$SCRIPT_DIR/run-checks" format-check-ci
    ;;
  format-fix)
    bash "$SCRIPT_DIR/run-checks" format-fix
    ;;
  app)
    shift
    app "$@"
    ;;
  configure)
    shift
    configure "$@"
    ;;
  *)
    help
    exit 1
    ;;
esac
